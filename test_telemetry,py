"""
Simple telemetry test script
"""

import time
import sys
import os

# Add parent directory to path
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from jidenna.core.robot_controller import RobotController

def test_telemetry_only():
    """Test just telemetry reception without plugins"""
    print("Testing telemetry only...")
    print("=" * 50)
    
    with RobotController(port="COM19") as robot:
        print("Waiting for telemetry...")
        
        # Wait for telemetry
        start_time = time.time()
        telemetry_received = 0
        
        while time.time() - start_time < 10:
            telemetry = robot.get_telemetry()
            if telemetry:
                telemetry_received += 1
                if telemetry_received == 1:
                    print(f"First telemetry received!")
                    print(f"Position: ({telemetry.x:.3f}, {telemetry.y:.3f})")
                    print(f"Yaw: {telemetry.yaw:.2f} deg")
                    print(f"Speed: {telemetry.linear_velocity:.3f} m/s")
                
                # Print every 10th
                if telemetry_received % 10 == 0:
                    print(f"Telemetry #{telemetry_received}: x={telemetry.x:.3f}, y={telemetry.y:.3f}")
            
            time.sleep(0.1)
        
        print(f"\nTotal telemetry packets received: {telemetry_received}")
        
        if telemetry_received > 0:
            print("✅ Telemetry working!")
        else:
            print("❌ No telemetry received - check robot connection and output")

if __name__ == "__main__":
    test_telemetry_only()